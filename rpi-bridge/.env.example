# サーバー設定
PORT=3210
HOST=127.0.0.1
# Cloudflare Tunnel 経由で外部からアクセスする場合は 0.0.0.0 に設定
BIND_HOST=127.0.0.1

# SQLite データベースファイルの保存先
DATABASE_PATH=/tmp/rotom-conversations.db

# OpenCode Go API 設定
OPENCODE_GO_API_KEY=your_opencode_go_api_key
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# MCP Bridge URL（ツール実行時に使用する内部向け URL）
# デフォルト: http://127.0.0.1:{PORT}
BRIDGE_URL=http://127.0.0.1:3210

# Web UI の保護者設定を開くための初期 PIN（数字4桁）
# 初回認証時に DB へ scrypt ハッシュとして保存され、以降は設定画面から変更可能
PARENT_PIN=1234

# Web チャットの会話履歴の保持日数（Discord は 30分固定で影響しない）
# アクセスのたびに期限が延長されるため、実質「最後に使ってから N 日」
WEB_SESSION_TTL_DAYS=30
