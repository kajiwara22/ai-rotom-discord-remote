@@ -0,0 +1,40 @@
+import { describe, it, expect } from "vitest";
+import { pokemonNameResolver } from "./name-resolvers";
+
+/**
+ * pokemonNameResolver はベースフォームのフォルム接尾辞を剥がした「素名」を
+ * alias として受け付ける。素名そのものを持たない種（ギルガルド等）を
+ * 素名で引けることを検証する。
+ */
+describe("pokemonNameResolver (bare-form aliases)", () => {
+  it.each([
+    ["ギルガルド", "Aegislash"],
+    ["フラエッテ", "Floette-Eternal"],
+    ["イッカネズミ", "Maushold"],
+    ["パンプジン", "Gourgeist"],
+  ])("素名 %s は %s へ解決される", (jaName, enName) => {
+    expect(pokemonNameResolver.hasJapaneseName(jaName)).toBe(true);
+    expect(pokemonNameResolver.toEnglish(jaName)).toBe(enName);
+  });
+
+  it("フォルム付きの正式名も引き続き解決される", () => {
+    expect(pokemonNameResolver.toEnglish("ギルガルド(シールドフォルム)")).toBe(
+      "Aegislash",
+    );
+    expect(pokemonNameResolver.toEnglish("ギルガルド(ブレードフォルム)")).toBe(
+      "Aegislash-Blade",
+    );
+  });
+
+  it("素名が既存エントリの種は alias で上書きされない", () => {
+    // 「モルペコ」は素名エントリが既に存在するため、
+    // 「モルペコ(はらぺこもよう)」からの alias を足さない。
+    expect(pokemonNameResolver.toEnglish("モルペコ")).toBe("Morpeko");
+  });
+
+  it("en→ja の逆引きは素名 alias に影響されず正式名を返す", () => {
+    expect(pokemonNameResolver.toJapanese("Aegislash")).toBe(
+      "ギルガルド(シールドフォルム)",
+    );
+  });
+});
