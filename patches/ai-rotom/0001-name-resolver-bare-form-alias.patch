 }
 
-export const pokemonNameResolver = new NameResolver(toNameEntries(pokemonData));
+/** pokemon.json は nameJa に加えて baseSpecies（素形判定用）を持つ。 */
+interface PokemonDataEntry {
+  readonly name: string;
+  readonly nameJa: string | null;
+  readonly baseSpecies: string | null;
+}
+
+/** 「X(フォルム)」のようなフォルム接尾辞付き名前から素名 X を抜き出す。 */
+const BARE_FORM_PATTERN = /^(.+)\([^()]*\)$/;
+
+/**
+ * pokemon 用の NameEntry を組み立てる。
+ *
+ * ai-rotom のデータには素名そのものを持たない種（例: `ギルガルド(シールドフォルム)`）が
+ * あり、素名 `ギルガルド` での照合が完全一致で引っかからない。そこでベースフォーム
+ * （`baseSpecies === null`）の名前からフォルム接尾辞を剥がした素名を alias として補完する。
+ * 素名が既存エントリとして存在する種（例: `モルペコ`）は alias を足さない。
+ */
+function toPokemonNameEntries(
+  data: readonly PokemonDataEntry[],
+): { entries: NameEntry[]; aliases: NameEntry[] } {
+  const entries = toNameEntries(data);
+  const canonicalJaNames = new Set(entries.map((e) => e.ja));
+  const aliases: NameEntry[] = [];
+  for (const entry of data) {
+    if (entry.nameJa === null) continue;
+    if (entry.baseSpecies !== null) continue;
+    const match = BARE_FORM_PATTERN.exec(entry.nameJa);
+    if (match === null) continue;
+    const bare = match[1];
+    if (bare.length === 0 || canonicalJaNames.has(bare)) continue;
+    aliases.push({ ja: bare, en: entry.name });
+  }
+  return { entries, aliases };
+}
+
+const pokemonEntries = toPokemonNameEntries(pokemonData);
+export const pokemonNameResolver = new NameResolver(
+  pokemonEntries.entries,
+  pokemonEntries.aliases,
+);
 export const natureNameResolver = new NameResolver(toNameEntries(naturesData));
 export const abilityNameResolver = new NameResolver(toNameEntries(abilitiesData));
 export const itemNameResolver = new NameResolver(toNameEntries(itemsData));
