+];
+
 describe("NameResolver", () => {
   const resolver = new NameResolver(TEST_ENTRIES);
 
@@ -64,4 +71,28 @@ describe("NameResolver", () => {
       expect(resolver.size).toBe(TEST_ENTRIES.length);
     });
   });
+
+  describe("aliases", () => {
+    const aliasedResolver = new NameResolver(TEST_ENTRIES, TEST_ALIASES);
+
+    it("should resolve a bare alias to its canonical English name", () => {
+      expect(aliasedResolver.hasJapaneseName("ギルガルド")).toBe(true);
+      expect(aliasedResolver.toEnglish("ギルガルド")).toBe("Aegislash");
+    });
+
+    it("should not override an existing entry with a colliding alias", () => {
+      expect(aliasedResolver.toEnglish("リザードン")).toBe("Charizard");
+    });
+
+    it("should not affect the en→ja reverse mapping", () => {
+      // 既存エントリの逆引きは alias に影響されない。
+      expect(aliasedResolver.toJapanese("Charizard")).toBe("リザードン");
+      // alias のみの en は逆引きに登録されない。
+      expect(aliasedResolver.toJapanese("Aegislash")).toBeUndefined();
+    });
+
+    it("should include bare aliases in similar-name suggestions", () => {
+      expect(aliasedResolver.suggestSimilar("ギルガルソ")).toContain("ギルガルド");
+    });
+  });
 });
